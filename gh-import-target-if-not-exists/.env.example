# Copy to .env and set values. See SPEC.md for API details.
#
# Snyk API authentication and org (UUIDs from Snyk UI or API).
SNYK_TOKEN=
SNYK_ORG_ID=
SNYK_INTEGRATION_ID=

# Repository clone URL, percent-encoded (e.g. https%3A%2F%2Fgitlab.com%2Fowner%2Fproject).
REPOSITORY_URL=https://github.com/my-company/my-repo

# Optional. Branch Snyk should import (defaults to main if unset).
REPO_BRANCH=main
